# ──────────────────────────────────────────────────────────────
# LearnMate AI Learning SaaS Environment Configuration
# ──────────────────────────────────────────────────────────────

# 1. Google Gemini API (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 2. Supabase Configuration (https://supabase.com/)
# Leave blank to run in local interactive demo mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Razorpay Payment Gateway (https://dashboard.razorpay.com/)
# Test mode credentials for Indian Rupee (INR) subscriptions
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# 4. Optional 3D Visual Generation API
IMAGE_GENERATION_API_KEY=
